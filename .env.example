# --- PostgreSQL (docker-compose) ------------------------------
POSTGRES_USER=komo
POSTGRES_PASSWORD=komo_secret
POSTGRES_DB=komo_art
POSTGRES_PORT=5432
DATABASE_URL="postgresql://komo:komo_secret@localhost:5432/komo_art?schema=public"

# --- Better-Auth ----------------------------------------------
# Generer avec : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-with-a-32+-chars-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudinary -----------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="komo-art"

# --- Divers ---------------------------------------------------
# Taux indicatif KMF -> EUR (parite fixe : 1 EUR = 491.96775 KMF)
NEXT_PUBLIC_KMF_PER_EUR=491.96775
